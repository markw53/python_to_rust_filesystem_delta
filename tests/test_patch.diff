+
+    def test_apply_symlink(self, tmp_path):
+        root = tmp_path / "root"
+        root.mkdir()
+        patch = tmp_path / "patch.json"
+        patch.write_text(
+            json.dumps([{"op": "symlink", "path": "link", "target": "real.txt"}])
