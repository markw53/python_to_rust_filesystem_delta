+        (dst / "link").symlink_to("real.txt")
+
+        patch = tmp_path / "patch.json"
+        run_compute(src, dst, patch)
+        run_apply(src, patch)
+
+        assert (src / "link").is_symlink()
+        assert os.readlink(src / "link") == "real.txt"
+
+    def test_roundtrip_modify(self, tmp_path):
+        src = tmp_path / "src"
+        dst = tmp_path / "dst"
