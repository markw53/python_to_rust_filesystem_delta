+
+    def test_compute_utimes_op(self, tmp_path):
+        src = tmp_path / "src"
+        dst = tmp_path / "dst"
+        src.mkdir()
+        dst.mkdir()
+        (src / "a.txt").write_text("x")
+        (dst / "a.txt").write_text("x")
+        os.utime(src / "a.txt", (100000, 100000))
+        os.utime(dst / "a.txt", (200000, 200000))
+
+        ops = compute_and_load(src, dst, tmp_path)
