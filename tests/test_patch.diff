+
+    def test_compute_type_change_dir_to_file(self, tmp_path):
+        src = tmp_path / "src"
+        dst = tmp_path / "dst"
+        src.mkdir()
+        dst.mkdir()
+        (src / "x").mkdir()
+        (dst / "x").write_text("hello")
+
+        ops = compute_and_load(src, dst, tmp_path)
